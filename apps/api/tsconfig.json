{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@drsell/shared": ["../../packages/shared/dist/index.d.ts"],
      "@drsell/shopify": ["../../packages/shopify/dist/index.d.ts"],
      "@drsell/adp": ["../../packages/adp/dist/index.d.ts"],
      "@shopify/shopify-api/adapters/node": [
        "./node_modules/@shopify/shopify-api/dist/ts/adapters/node/index.d.ts"
      ]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
