generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shops     Shop[]
  users     AdminUser[]
  products  Product[]
  orders    Order[]
  customers Customer[]
}

model Shop {
  id                    String    @id @default(cuid())
  shopDomain            String    @unique
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  accessToken           String?
  /// Shopify offline refresh token（AES 加密，与 accessToken 同钥）
  refreshToken          String?
  /// access token 过期时间；null 表示历史「不过期」offline token，待 migrate
  accessTokenExpiresAt  DateTime?
  /// refresh token 过期时间
  refreshTokenExpiresAt DateTime?
  scopes                String?
  installedAt           DateTime  @default(now())
  uninstalledAt         DateTime?
  botSetting            BotSetting?
  inboxUsers            InboxUser[]
  sessions              Session[]
  subscriptions         Subscription[]
  memberships           Membership[]
  products              Product[]
  orders                Order[]
  customers             Customer[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  aiUsage               AiUsage[]

}

model Session {
  id          String    @id
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id])
  state       String?
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BotSetting {
  id                    String    @id @default(cuid())
  shopId                String    @unique
  shop                    Shop      @relation(fields: [shopId], references: [id])
  shopName              String?
  botId                 String?
  adpAppKey             String?
  chatLogo              String?
  chatAvatar            String?
  onboardingStep        String    @default("1")
  onboardingCompletedAt DateTime?
  embedLiveAt           DateTime?
  widgetPrimaryColor    String?   @default("#008060")
  widgetHeaderColor     String?   @default("#008060")
  widgetPosition        String?   @default("bottom-right")
  widgetWindowSize      String?   @default("medium")
  widgetLauncherStyle   String?   @default("chat")
  widgetVisible         Boolean?  @default(true)
  widgetQuickReplies    Json?
  welcomeMessage        String?
  welcomeMessageI18n    Json?
  syncProductsEnabled   Boolean   @default(true)
  syncOrdersEnabled     Boolean   @default(true)
  syncCustomersEnabled  Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model InboxUser {
  id          String  @id @default(cuid())
  shopId      String
  shop        Shop    @relation(fields: [shopId], references: [id])
  userEmail   String
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, userEmail])
}

model AdminUser {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  memberships  Membership[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 账号 ↔ 店铺归属。唯一决定「谁能操作哪家店」。
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// owner = 安装者；member = 被邀请的坐席
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, shopId])
  @@index([shopId])
}

model Subscription {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  planCode  String
  /// 镜像 Shopify AppSubscriptionStatus：PENDING ACTIVE FROZEN DECLINED EXPIRED CANCELLED
  status        String
  trialEnds DateTime?
  frozenAt      DateTime?
  /// frozenAt + 30 天。Shopify 在此之前恢复付款可自动解冻，逾期进终态。
  unfreezeBy    DateTime?
  currentPeriodEnd DateTime?
  /// 组内唯一收全额的店；其余店建 $0 charge
  isBillingShop  Boolean @default(false)
  shopifyChargeId String?
  seats          Int     @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 运营台操作留痕。INV-3 的落地载体。
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  shopDomain String?
  targetId   String?
  payload    Json?
  result     String   @default("ok")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([shopDomain, createdAt])
  @@index([actorId, createdAt])
}

model MailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  shopDomain String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeSyncJob {
  id         String   @id @default(cuid())
  shopDomain String
  kind       String
  externalId String
  status     String
  payload    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChatStatDaily {
  id               String   @id @default(cuid())
  shopDomain       String
  day              DateTime
  count            Int      @default(0)
  aiResolvedCount  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shopDomain, day])
}

/// AI 回答用量计数 —— 按店铺 + 计费周期累计。
///
/// 为什么单独建表而不是从 ChatMessage 现算：配额要在每次对话前判断，
/// 现算需要 ChatMessage join ChatThread 再按店铺过滤，随会话量线性变慢；
/// 这里一次 upsert 递增、一次主键读，代价恒定。
///
/// periodStart 取订阅当期起点（currentPeriodEnd - 30d），无订阅时回落自然月，
/// 这样配额随扣费重置，而不是随日历月。
///
/// 用 shopId 外键而非 shopDomain 字符串：本仓的 soft_tenant_models 棘轮正在
/// 偿还「按字符串圈租户」的欠账，新表不该再添一笔。
model AiUsage {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  periodStart DateTime
  /// 本周期已产出的 AI 回答次数（仅成功产出才计）
  answers     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, periodStart])
  @@index([shopId, periodStart])
}

/// 访客会话线程 — storefront inbox / dashboard
model ChatThread {
  id          String        @id @default(cuid())
  shopDomain  String
  visitorId   String
  status      String        @default("ai")
  channel     String        @default("web")
  topic       String?
  lastMessage String?       @db.Text
  unread      Int           @default(0)
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([shopDomain, visitorId])
  @@index([shopDomain, updatedAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String     @db.Text
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

/// Shopify 商品 — 按 tenantId（店铺租户）隔离
model Product {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  shopId           String?  @map("shop_id")
  shop             Shop?    @relation(fields: [shopId], references: [id])
  shopifyProductId String   @map("shopify_product_id")
  name             String
  price            Decimal? @db.Decimal(10, 2)
  description      String?  @db.Text
  category         String?
  stock            Int?
  handle           String?
  vendor           String?
  status           String?
  tags             String?
  variantsJson     String?  @map("variants_json") @db.Text
  imagesJson       String?  @map("images_json") @db.Text
  publishedAt      DateTime? @map("published_at")
  syncedAt         DateTime @default(now()) @map("synced_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, shopifyProductId])
  @@index([tenantId])
  @@map("products")
}

/// Shopify 订单 — 按 tenantId + customerId 查询
model Order {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  shopId             String?  @map("shop_id")
  shop               Shop?    @relation(fields: [shopId], references: [id])
  shopifyOrderId     String   @map("shopify_order_id")
  customerId         String?  @map("customer_id")
  status             String?
  financialStatus    String?  @map("financial_status")
  fulfillmentStatus  String?  @map("fulfillment_status")
  total              Decimal  @db.Decimal(10, 2)
  totalTax           Decimal? @map("total_tax") @db.Decimal(10, 2)
  billingAddress     String?  @map("billing_address") @db.Text
  shippingAddress    String?  @map("shipping_address") @db.Text
  shopifyCreatedAt   DateTime? @map("shopify_created_at")
  syncedAt           DateTime @default(now()) @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, shopifyOrderId])
  @@index([tenantId, customerId])
  @@map("orders")
}

/// Shopify 客户 — 按 tenantId 隔离
model Customer {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  shopId             String?  @map("shop_id")
  shop               Shop?    @relation(fields: [shopId], references: [id])
  shopifyCustomerId  String   @map("shopify_customer_id")
  displayName        String?  @map("display_name")
  email              String?
  phone              String?
  syncedAt           DateTime @default(now()) @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, shopifyCustomerId])
  @@index([tenantId])
  @@map("customers")
}

/// Shopify 强制合规 webhook 留痕（customers/data_request、customers/redact、shop/redact）
model ComplianceEvent {
  id         String   @id @default(cuid())
  topic      String
  shopDomain String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([shopDomain])
}
