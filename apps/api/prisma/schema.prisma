generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shops     Shop[]
  users     AdminUser[]
  products  Product[]
  orders    Order[]
  customers Customer[]
}

model Shop {
  id                    String    @id @default(cuid())
  shopDomain            String    @unique
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  accessToken           String?
  /// Shopify offline refresh token（AES 加密，与 accessToken 同钥）
  refreshToken          String?
  /// access token 过期时间；null 表示历史「不过期」offline token，待 migrate
  accessTokenExpiresAt  DateTime?
  /// refresh token 过期时间
  refreshTokenExpiresAt DateTime?
  scopes                String?
  installedAt           DateTime  @default(now())
  uninstalledAt         DateTime?
  botSetting            BotSetting?
  expiryNotices         ExpiryNotice[]
  inboxUsers            InboxUser[]
  sessions              Session[]
  subscriptions         Subscription[]
  memberships           Membership[]
  products              Product[]
  orders                Order[]
  customers             Customer[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  aiUsage               AiUsage[]

}

model Session {
  id          String    @id
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id])
  state       String?
  isOnline    Boolean   @default(false)
  scope       String?
  expires     DateTime?
  accessToken String
  userId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BotSetting {
  id                    String    @id @default(cuid())
  shopId                String    @unique
  shop                    Shop      @relation(fields: [shopId], references: [id])
  shopName              String?
  botId                 String?
  adpAppKey             String?
  chatLogo              String?
  chatAvatar            String?
  onboardingStep        String    @default("1")
  onboardingCompletedAt DateTime?
  embedLiveAt           DateTime?
  widgetPrimaryColor    String?   @default("#008060")
  widgetHeaderColor     String?   @default("#008060")
  widgetPosition        String?   @default("bottom-right")
  widgetWindowSize      String?   @default("medium")
  widgetLauncherStyle   String?   @default("chat")
  widgetVisible         Boolean?  @default(true)
  widgetQuickReplies    Json?
  welcomeMessage        String?
  welcomeMessageI18n    Json?
  syncProductsEnabled   Boolean   @default(true)
  syncOrdersEnabled     Boolean   @default(true)
  syncCustomersEnabled  Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model InboxUser {
  id          String  @id @default(cuid())
  shopId      String
  shop        Shop    @relation(fields: [shopId], references: [id])
  userEmail   String
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, userEmail])
}

model AdminUser {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  memberships  Membership[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 账号 ↔ 店铺归属。唯一决定「谁能操作哪家店」。
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// owner = 安装者；member = 被邀请的坐席
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, shopId])
  @@index([shopId])
}

model Subscription {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  planCode  String
  /// 镜像 Shopify AppSubscriptionStatus：PENDING ACTIVE FROZEN DECLINED EXPIRED CANCELLED
  status        String
  trialEnds DateTime?
  frozenAt      DateTime?
  /// frozenAt + 30 天。Shopify 在此之前恢复付款可自动解冻，逾期进终态。
  unfreezeBy    DateTime?
  currentPeriodEnd DateTime?
  /// 组内唯一收全额的店；其余店建 $0 charge
  isBillingShop  Boolean @default(false)
  /// Shopify AppSubscription.test：开发店/审核用的测试扣款。测试订阅永不续期，
  /// currentPeriodEnd 会永远停在第一期终点而 status 保持 ACTIVE——不单独标记
  /// 就会被闸门判成「周期已过」，把 Shopify 审核员也一起停掉。
  isTest         Boolean @default(false)
  shopifyChargeId String?
  seats          Int     @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 运营台操作留痕。INV-3 的落地载体。
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  shopDomain String?
  targetId   String?
  payload    Json?
  result     String   @default("ok")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([shopDomain, createdAt])
  @@index([actorId, createdAt])
}

model MailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  shopDomain String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeSyncJob {
  id         String   @id @default(cuid())
  shopDomain String
  kind       String
  externalId String
  status     String
  payload    String?
  /// 运行中任务的心跳。超时判定必须基于它而不是 createdAt——按创建时间会误杀
  /// 长时间但健康的大目录同步。心跳停摆的 running 任务由启动清理推向 failed，
  /// 否则并发守卫会让该店该类目永久不再同步。
  heartbeatAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, heartbeatAt])
}

model ChatStatDaily {
  id               String   @id @default(cuid())
  shopDomain       String
  day              DateTime
  /// 消息数（旧口径）。ops 的 chatCount 仍在用，故保留。
  count            Int      @default(0)
  /// 弃用：AI 消息数（旧口径）。曾被当作会话数塞进图表，与 human 序列单位不同。
  /// 新写入已停止；ops 的 AI 用量改读 AiUsage.answers（配额的权威计数）。
  aiResolvedCount  Int      @default(0)
  /// 当天有活动的会话数。图表与分流率的分母。
  threadCount      Int      @default(0)
  /// 当天被人工接管的会话数。图表的 human 序列；ai 序列 = threadCount - 它。
  humanThreadCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shopDomain, day])
}

/// AI 回答用量计数 —— 按店铺 + 计费周期累计。
///
/// 为什么单独建表而不是从 ChatMessage 现算：配额要在每次对话前判断，
/// 现算需要 ChatMessage join ChatThread 再按店铺过滤，随会话量线性变慢；
/// 这里一次 upsert 递增、一次主键读，代价恒定。
///
/// periodStart 取订阅当期起点（currentPeriodEnd - 30d），无订阅时回落自然月，
/// 这样配额随扣费重置，而不是随日历月。
///
/// 用 shopId 外键而非 shopDomain 字符串：本仓的 soft_tenant_models 棘轮正在
/// 偿还「按字符串圈租户」的欠账，新表不该再添一笔。
model AiUsage {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  periodStart DateTime
  /// 本周期已产出的 AI 回答次数（仅成功产出才计）
  answers     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, periodStart])
  @@index([shopId, periodStart])
}

/// 到期提醒的去重记录。
///
/// 键是「店 + 周期 + 档位」：同一店、同一计费周期、同一档（D-3/D-2/D-1）
/// 最多发一次。必须持久化——进程内记忆挡不住重启和多实例，那会重复打扰商家。
/// 新周期重新计数，靠 periodEnd 作为键的一部分自然实现。
model ExpiryNotice {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// 该次提醒针对的计费周期结束时刻
  periodEnd  DateTime
  /// 到期前第几天：3 / 2 / 1
  dayOffset  Int
  /// 出站是否真的送达。sendDunning 曾经只排队给一个不存在的 worker，
  /// 结果催缴从未发出——这里必须记下真实结果，失败要能被发现。
  delivered  Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@unique([shopId, periodEnd, dayOffset])
  @@index([shopId, periodEnd])
}

/// 访客会话线程 — storefront inbox / dashboard
/// 会话归属状态。裸 String 曾让 'human' 成为一个前端自说自话、后端从不写入的
/// 幽灵取值——指标据此计算，于是恒为零。词表由数据库守住，应用层写错即 5xx。
enum ChatThreadStatus {
  ai
  pending
  human
  closed
}

/// 消息作者。agent = 商家人工回复，必须与 AI 的 assistant 区分：
/// 旧前端把商家消息标成 user，落库后模型会把商家的话当成顾客说的。
enum ChatMessageRole {
  user
  assistant
  agent
}

model ChatThread {
  id            String           @id @default(cuid())
  shopDomain    String
  visitorId     String
  status        ChatThreadStatus @default(ai)
  channel       String           @default("web")
  topic         String?
  lastMessage   String?          @db.Text
  unread        Int              @default(0)
  /// 最近一次转人工的时刻。图表与分流率按它切窗——用当前 status 算会把历史
  /// 会话的终态算进当期。
  handedOverAt  DateTime?
  closedAt      DateTime?
  messages      ChatMessage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([shopDomain, visitorId])
  @@index([shopDomain, updatedAt])
  @@index([shopDomain, handedOverAt])
}

model ChatMessage {
  id        String          @id @default(cuid())
  threadId  String
  thread    ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      ChatMessageRole
  content   String          @db.Text
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
}

/// Shopify 商品 — 按 tenantId（店铺租户）隔离
model Product {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  shopId           String?  @map("shop_id")
  shop             Shop?    @relation(fields: [shopId], references: [id])
  shopifyProductId String   @map("shopify_product_id")
  name             String
  price            Decimal? @db.Decimal(10, 2)
  description      String?  @db.Text
  category         String?
  stock            Int?
  handle           String?
  vendor           String?
  status           String?
  tags             String?
  variantsJson     String?  @map("variants_json") @db.Text
  imagesJson       String?  @map("images_json") @db.Text
  publishedAt      DateTime? @map("published_at")
  syncedAt         DateTime @default(now()) @map("synced_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, shopifyProductId])
  @@index([tenantId])
  @@map("products")
}

/// Shopify 订单 — 按 tenantId + customerId 查询
model Order {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  shopId             String?  @map("shop_id")
  shop               Shop?    @relation(fields: [shopId], references: [id])
  shopifyOrderId     String   @map("shopify_order_id")
  customerId         String?  @map("customer_id")
  status             String?
  financialStatus    String?  @map("financial_status")
  fulfillmentStatus  String?  @map("fulfillment_status")
  total              Decimal  @db.Decimal(10, 2)
  totalTax           Decimal? @map("total_tax") @db.Decimal(10, 2)
  billingAddress     String?  @map("billing_address") @db.Text
  shippingAddress    String?  @map("shipping_address") @db.Text
  shopifyCreatedAt   DateTime? @map("shopify_created_at")
  syncedAt           DateTime @default(now()) @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, shopifyOrderId])
  @@index([tenantId, customerId])
  @@map("orders")
}

/// Shopify 客户 — 按 tenantId 隔离
model Customer {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  shopId             String?  @map("shop_id")
  shop               Shop?    @relation(fields: [shopId], references: [id])
  shopifyCustomerId  String   @map("shopify_customer_id")
  displayName        String?  @map("display_name")
  email              String?
  phone              String?
  syncedAt           DateTime @default(now()) @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, shopifyCustomerId])
  @@index([tenantId])
  @@map("customers")
}

/// Shopify 强制合规 webhook 留痕（customers/data_request、customers/redact、shop/redact）
model ComplianceEvent {
  id         String   @id @default(cuid())
  topic      String
  shopDomain String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([shopDomain])
}
