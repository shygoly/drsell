{
  "meta": {
    "lastTouchedVersion": "2026.6.6"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek-v4": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "REPLACE_WITH_DEEPSEEK_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          },
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 1048576,
            "maxTokens": 8192
          }
        ]
      },
      "zhipu": {
        "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
        "apiKey": "REPLACE_WITH_GLM_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-4.5-flash",
            "name": "GLM 4.5 Flash",
            "input": [
              "text"
            ],
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek-v4/deepseek-v4-flash",
        "fallbacks": [
          "zhipu/glm-4.5-flash"
        ]
      },
      "workspace": "/root/.openclaw/workspace-drsell",
      "maxConcurrent": 4
    }
  },
  "gateway": {
    "port": 18790,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_GATEWAY_TOKEN"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "drsell-pg": {
        "command": "node",
        "args": [
          "/usr/lib/node_modules/@modelcontextprotocol/server-postgres/dist/index.js",
          "postgresql://adp_reader:REPLACE_ADP_READER_PASSWORD@127.0.0.1:5433/drsell?sslmode=disable"
        ]
      }
    }
  }
}
